# ==============================================================================
# Intermarket Curve Intelligence Platform - Environment Configuration
# Copy this file to .env and configure your Lightstreamer credentials
# ==============================================================================

# Enable Lightstreamer Live Market Data Streaming (1 = Enabled, 0 = Disabled)
ENABLE_LIGHTSTREAMER=1

# Lightstreamer Server & Adapter Endpoints
LIGHTSTREAMER_URL=https://ls-md.corp.hertshtengroup.com/
LIGHTSTREAMER_ADAPTER=TTsdkLSAdapter
LIGHTSTREAMER_DATA_ADAPTER=HGL1_Adapter

# Lightstreamer Authentication Credentials
# Provide your organization/personal Lightstreamer user and token / JWT below:
LS_USER=your.username
LS_TOKEN=YOUR_LIGHTSTREAMER_JWT_OR_AUTH_TOKEN_HERE

# Optional API Tokens
QH_API_TOKEN=YOUR_QH_API_TOKEN_HERE

# Platform Web Server Port & Host
PORT=8050
HOST=0.0.0.0
